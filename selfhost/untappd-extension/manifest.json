{
  "manifest_version": 3,
  "name": "Bierkelder voor Untappd",
  "version": "1.3.0",
  "description": "Synchroniseert op verzoek de zichtbare Untappd-gegevens met bier.example.com.",
  "permissions": ["storage"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [
    {"matches": ["https://bier.example.com/*"], "js": ["cellar.js"]},
    {"matches": ["https://untappd.com/*"], "js": ["untappd.js"]}
  ]
}
